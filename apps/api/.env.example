#Postgre
POSTGRE_URL=value
POSTGRE_USERNAME=value
POSTGRE_PASSWORD =value

#JWT
JWT_SECRET=value

#Redis
REDIS_HOST=localhost
REDIS_PORT=6379

#LLM (OpenAI-compatible)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=value
LLM_MODEL=value

#Mail xác minh (Gmail SMTP). VALIDATION_PWD là App Password 16 ký tự, không phải mật khẩu Gmail
VALIDATION_MAIL=you@gmail.com
VALIDATION_PWD=value

#OAuth (Google, GitHub). Dev: GitHub OAuth App có callback http://localhost:5173/api/login/oauth2/code/github
GOOGLE_CLIENT_ID=value
GOOGLE_CLIENT_SECRET=value
GITHUB_CLIENT_ID=value
GITHUB_CLIENT_SECRET=value
